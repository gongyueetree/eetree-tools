* flash-adc
* Converted from CircuitJS by eetree.cn/tools - open in LTspice (File > Open, then Run)
* Suggested traces: V(N008)
.param R1=${R1} R2=${R2} R3=${R3} R4=${R4} R5=${R5} R6=${R6} R7=${R7} R8=${R8} VREF=${VREF}
R1 N001 0 {R1}
R2 N002 N001 {R2}
R3 N003 N002 {R3}
R4 N004 N003 {R4}
R5 N005 N004 {R5}
R6 N006 N005 {R6}
R7 N007 N006 {R7}
R8 vref N007 {R8}
VREF vref 0 {VREF}
V1 N008 0 PULSE(${(VREF/2)-(VREF/2)} ${(VREF/2)+(VREF/2)} 0 ${0.5/(F)} ${0.5/(F)} 0 ${1/(F)})
* op-amp 1: A0=100000, GBW=1000000, output limited to [0, 5]
G_OA1 0 OA1 N008 N001 1
R_OA1 OA1 0 100k
C_OA1 OA1 0 159.1549431n
B_OA1 T1 0 V=min(max(V(OA1), 0), 5)
* op-amp 2: A0=100000, GBW=1000000, output limited to [0, 5]
G_OA2 0 OA2 N008 N002 1
