# eetree-sim 1
# name dds-lpf
# param fc 50000000
# param SCOPE_W 512
# param C1 2.8332245264458096e-11
# param L1 1.984629678664077e-07
# param C2 1.1471491911886311e-10
# param L2 3.183098861837907e-07
# param C3 1.1471491911886311e-10
