* lc-lp-pi-5
* Converted from CircuitJS by eetree.cn/tools - open in LTspice (File > Open, then Run)
* Suggested traces: V(OUT)
.param C1=${C1} C2=${C2} C3=${C3} L1=${L1} L2=${L2} RL=${RL} RS=${RS} fmax=${fmax} fmin=${fmin}
RS N001 N002 {RS}
C1 N002 0 {C1} IC=0
L1 N002 N003 {L1} IC=0
C2 N003 0 {C2} IC=0
L2 N003 OUT {L2} IC=0
C3 OUT 0 {C3} IC=0
RL OUT 0 {RL}
V1 N001 0 DC 0 AC 2
.ac dec 100 {fmin} {fmax}
.end
